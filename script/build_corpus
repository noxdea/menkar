sources.each do |directory, (encoding, texts)|
  target = File.join(root, directory)
  FileUtils.mkdir_p(target)
  texts.each_with_index do |text, index|
    File.binwrite(File.join(target, format("%02d.txt", index + 1)), "#{text}\r\n".encode(encoding))
  end
end
